[Desktop Entry]
Type=Application
Name=BetterLogi
Comment=Logitech HID++ device control — remap buttons, DPI, SmartShift
Comment[es]=Control de dispositivos Logitech HID++: reasignación de botones, DPI y SmartShift
Exec=betterlogi-desktop
Icon=betterlogi
Terminal=false
# Ties the running window (Wayland xdg-toplevel app_id / X11 WM_CLASS) back to
# this launcher so GNOME groups it under the BetterLogi icon instead of a generic
# one. Must match `betterlogi_core::brand::APP_ID`, the value the GUI advertises.
StartupWMClass=org.betterlogi.betterlogi
Categories=Settings;HardwareSettings;
Keywords=logitech;mouse;hid;remap;dpi;
StartupNotify=true
